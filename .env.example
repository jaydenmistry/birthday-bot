# copy to /etc/birthday-bot/birthday-bot.env and chmod 600. never commit the real file.

# bot token from the discord developer portal (bot > reset token)
DISCORD_BOT_TOKEN=

# timezone used to decide what "today" is
BOT_TIMEZONE=America/New_York

# where the sqlite database lives (the systemd unit sets this already)
# BIRTHDAY_DB=/var/lib/birthday-bot/birthdays.db
