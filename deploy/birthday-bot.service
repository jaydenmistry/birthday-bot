[Unit]
Description=Discord birthday bot
Documentation=https://github.com/jaydenmistry/birthday-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=birthday-bot
Group=birthday-bot
WorkingDirectory=/opt/birthday-bot
EnvironmentFile=/etc/birthday-bot/birthday-bot.env
Environment=BIRTHDAY_DB=/var/lib/birthday-bot/birthdays.db
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/birthday-bot/venv/bin/python -m birthday_bot
Restart=always
RestartSec=10

# data lives in /var/lib/birthday-bot, created and owned by systemd
StateDirectory=birthday-bot
StateDirectoryMode=0700
UMask=0077

# sandbox: the bot can read its code, write only its data, and reach the network
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
